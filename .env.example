# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- Application -------------------------------------------------------------
# local | test | production
FAMILY_PNL_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
FAMILY_PNL_LOG_LEVEL=INFO
# true for JSON lines (production), false for readable console output
FAMILY_PNL_LOG_JSON=false
# Default household time zone (IANA name)
FAMILY_PNL_DEFAULT_TIMEZONE=Europe/Minsk
# Async SQLAlchemy URL; must match the POSTGRES_* values below.
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and the dev
# database listens on IPv4 only, which adds about 2 s to every new connection.
FAMILY_PNL_DATABASE_URL=postgresql+asyncpg://family_pnl:change-me@127.0.0.1:5432/family_pnl
# HS256 signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FAMILY_PNL_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
FAMILY_PNL_ACCESS_TOKEN_TTL_MINUTES=15
FAMILY_PNL_REFRESH_TOKEN_TTL_DAYS=30
# Redis: login rate limiting (and the job queue later)
FAMILY_PNL_REDIS_URL=redis://127.0.0.1:6379/0
# Failed logins allowed per email and per IP within the window
FAMILY_PNL_LOGIN_MAX_FAILURES=5
FAMILY_PNL_LOGIN_FAILURE_WINDOW_SECONDS=900
# Shared secret between the API and the Telegram bot (at least 32 characters);
# leave unset to disable the /bot endpoints. Generate it like the JWT secret.
FAMILY_PNL_BOT_API_SECRET=change-me-to-another-random-string-of-32-characters
# Telegram bot token from @BotFather; the worker sends notifications with it.
# Leave empty: notifications wait in the database until it is set.
FAMILY_PNL_TELEGRAM_BOT_TOKEN=
# Days of the month before a budget month when members may edit its draft
FAMILY_PNL_BUDGET_WINDOW_START_DAY=20
FAMILY_PNL_BUDGET_WINDOW_END_DAY=30

# --- Local PostgreSQL (docker-compose.dev.yml) -------------------------------
POSTGRES_USER=family_pnl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=family_pnl

# --- Tests -------------------------------------------------------------------
# Optional. When set, integration tests use these servers (CI does this), otherwise they
# start throwaway containers. The test database is created if missing; parallel workers
# (pytest -n) get family_pnl_test_gwN and Redis databases 1, 2, ... Never point these at
# the dev database itself: a migration test downgrades the schema to nothing.
TEST_DATABASE_URL=postgresql+asyncpg://family_pnl:change-me@127.0.0.1:5432/family_pnl_test
TEST_REDIS_URL=redis://127.0.0.1:6379/1
